{
  "openapi": "3.0.4",
  "info": {
    "title": "IDP.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/Auth/Login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/Auth/RegisterAndSendOtp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/Users/Insert": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthCommand": {
        "required": [
          "mobileNumber"
        ],
        "type": "object",
        "properties": {
          "mobileNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AuthQuery": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserCommands": {
        "required": [
          "codeNumber",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "minLength": 3,
            "type": "string"
          },
          "codeNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "User"
    }
  ]
}