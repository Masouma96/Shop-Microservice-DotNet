{
  "openapi": "3.0.4",
  "info": {
    "title": "IDP.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/Auth/Login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AuthQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/JsonWebToken"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonWebToken"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonWebToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Auth/RegisterAndSendOtp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "boolean"
                }
              },
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              },
              "text/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/User/Insert": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommands"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "boolean"
                }
              },
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              },
              "text/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthCommand": {
        "type": "object",
        "properties": {
          "mobileNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AuthQuery": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JsonWebToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "expires": {
            "type": "integer",
            "format": "int64"
          },
          "refreshToken": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "UserCommands": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "codeNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "User"
    }
  ]
}